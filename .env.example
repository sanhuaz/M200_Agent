APP_ENV=development
FRONTEND_ORIGIN=http://127.0.0.1:5176
DATABASE_PATH=./data/personal_agent.db
CHROMA_PATH=./data/chroma
UPLOAD_PATH=./data/uploads
DOWNLOAD_PATH=./data/downloads
CHAT_IMAGE_PATH=./data/chat-images
TOOLS_PATH=./tools
SKILLS_PATH=./skills
WORKSPACE_PATH=./workspace
PERSONA_PATH=./persona

# JSON array for the first startup import. After initialization, edit models from the Web "模型管理" page.
# API keys are referenced by environment-variable name, never stored in this JSON value.
MODEL_PROFILES_JSON=[{"alias":"default","model":"your-tool-capable-model","base_url":"https://api.example.com/v1","api_key_env":"PERSONAL_AGENT_LLM_API_KEY","reasoning_effort":null,"streaming":true,"temperature":null,"context_window":1000000,"input_soft_limit":131072,"max_output_tokens":16384,"timeout_seconds":120,"supports_vision":false}]
PERSONAL_AGENT_LLM_API_KEY=

DEFAULT_EMBEDDING_PROFILE=local-bge
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
ONLINE_EMBEDDING_MODEL=text-embedding-3-small
ONLINE_EMBEDDING_BASE_URL=https://api.openai.com/v1
ONLINE_EMBEDDING_API_KEY_ENV=PERSONAL_AGENT_EMBEDDING_API_KEY
PERSONAL_AGENT_EMBEDDING_API_KEY=

RERANK_ENABLED=false
RERANK_URL=https://api.siliconflow.cn/v1/rerank
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_KEY=

ONEBOT_TOKEN=change-me
OWNER_QQ_IDS=[]
QQ_UPLOAD_LIMIT_MB=100
GROUP_COMMAND_PREFIX=/ai

# MCP 默认连接上限；Server 具体配置在 Web 设置页保存
MCP_CONNECT_TIMEOUT_SECONDS=15
MCP_READ_TIMEOUT_SECONDS=120
MCP_CATALOG_ITEM_LIMIT=200

# 可选：实时日志页连接 NapCat 官方 WebUI 的本机 SSE 日志流
NAPCAT_WEBUI_URL=http://127.0.0.1:6099
NAPCAT_WEBUI_TOKEN=
